{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://3glish.app/schemas/exercise.schema.json",
  "title": "3glish Exercise",
  "type": "object",
  "required": ["exercise_id", "modality", "answers"],
  "properties": {
    "exercise_id": { "type": "string", "minLength": 1 },
    "base_sentence_id": { "type": "string" },
    "date": { "type": "string", "format": "date" },
    "language_pair": { "type": "string" },
    "weekly_word": { "type": "string" },
    "modality": {
      "type": "string",
      "enum": [
        "translation",
        "reverse_translation",
        "fill_blank",
        "multiple_choice",
        "true_false",
        "pronunciation"
      ]
    },
    "prompt": { "type": "string" },
    "answers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["text"],
        "properties": {
          "text": { "type": "string", "minLength": 1 },
          "acceptance": {
            "type": "string",
            "enum": ["canonical", "variant", "lenient"]
          },
          "explanation_pt": { "type": "string" }
        },
        "additionalProperties": true
      }
    },
    "meta": { "type": "object" },
    "sentence_en": { "type": "string" },
    "blanked_sentence_en": { "type": "string" },
    "blank_token": { "type": "string" },
    "question": { "type": "string" },
    "options": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 2
    },
    "correct_index": { "type": "integer", "minimum": 0 },
    "statement": { "type": "string" },
    "label": { "type": "string" },
    "pronunciation_hint": { "type": "string" },
    "voice": { "type": "string" },
    "audio_file": {
      "type": "string",
      "not": {
        "pattern": "^(?:[A-Za-z]:\\\\|/)"
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "modality": { "const": "multiple_choice" } } },
      "then": { "required": ["question", "options", "correct_index"] }
    },
    {
      "if": { "properties": { "modality": { "const": "fill_blank" } } },
      "then": { "required": ["blanked_sentence_en", "blank_token"] }
    },
    {
      "if": { "properties": { "modality": { "const": "reverse_translation" } } },
      "then": { "required": ["sentence_en"] }
    },
    {
      "if": { "properties": { "modality": { "const": "true_false" } } },
      "then": { "required": ["statement", "label"] }
    }
  ],
  "additionalProperties": true
}
