{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://3glish.app/schemas/attempt.schema.json",
  "title": "3glish Attempt",
  "type": "object",
  "required": ["attempt_id", "pack_id", "exercise_id", "modality", "ts", "result"],
  "properties": {
    "attempt_id": { "type": "string", "minLength": 1 },
    "pack_id": { "type": "string", "minLength": 1 },
    "exercise_id": { "type": "string", "minLength": 1 },
    "modality": {
      "type": "string",
      "enum": [
        "translation",
        "reverse_translation",
        "fill_blank",
        "multiple_choice",
        "true_false",
        "pronunciation"
      ]
    },
    "ts": { "type": "string", "format": "date-time" },
    "result": {
      "type": "string",
      "enum": ["correct", "wrong", "done_no_grade"]
    },
    "user_answer": {
      "oneOf": [
        { "type": "string" },
        { "type": "number" },
        { "type": "boolean" },
        { "type": "null" }
      ]
    },
    "pronunciation_metrics": {
      "type": "object",
      "properties": {
        "played_count": { "type": "integer", "minimum": 0 },
        "speed": { "type": "number", "minimum": 0.75, "maximum": 1.5 },
        "self_rating": {
          "oneOf": [
            { "type": "integer", "minimum": 1, "maximum": 5 },
            { "type": "null" }
          ]
        }
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": { "properties": { "modality": { "const": "pronunciation" } } },
      "then": { "properties": { "result": { "const": "done_no_grade" } } },
      "else": {
        "properties": {
          "result": { "enum": ["correct", "wrong"] }
        }
      }
    }
  ],
  "additionalProperties": false
}
